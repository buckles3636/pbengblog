{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "lib/**/*.ts",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
