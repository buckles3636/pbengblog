# Copy to .env; never commit real credentials.
POSTGRES_USER=pbengblog
POSTGRES_DB=pbengblog
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://pbengblog:replace-with-a-long-random-password@127.0.0.1:5544/pbengblog
EDITOR_USERNAME=editor
EDITOR_PASSWORD=replace-with-a-different-long-random-password
# Independent session key: generate with openssl rand -hex 32.
EDITOR_SESSION_SECRET=replace-with-a-random-session-key
SITE_NAME=Engineering Notebook
SITE_DESCRIPTION=Projects, experiments, and engineering field notes.
SITE_AUTHOR=Your Name
SITE_URL=https://example.com
# Persistent uploads, source backups, and migration reports are ignored by Git.
DATA_DIR=.local
# Set explicitly when serving the editor behind HTTPS.
EDITOR_ORIGIN=http://localhost:3011
# Optional authenticated reverse proxy; leave unset for direct loopback access.
# EDITOR_PROXY_SECRET=replace-with-an-independent-random-proxy-key

# Enable after configuring and starting the background publisher.
PUBLISHER_ENABLED=false
